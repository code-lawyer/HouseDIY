# Publish only product source, reproducible tests, documentation and examples.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/src/
!/public/
!/tests/
!/vendor/
!/build/
!/examples/
!/docs/
!/scripts/
!/package.json
!/package-lock.json
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/design-qa.md

# Local acceptance scripts contain private fixtures and historical evidence.
/scripts/*
!/scripts/dev.mjs
!/scripts/electron-qa.mjs
!/scripts/qa-startup.mjs
!/scripts/qa-regressions.mjs
!/scripts/qa-first-fixes.mjs
!/scripts/qa-model-assets.mjs
!/scripts/audit-ui.mjs

node_modules/
*.log
.env
.env.*
*.lnk
