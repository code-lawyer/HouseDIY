{
  "name": "housediy",
  "version": "0.1.5",
  "description": "本地户型与 AI 协同设计工作台",
  "productName": "HouseDIY",
  "author": "HouseDIY contributors",
  "license": "MIT",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "serve": "node scripts/dev.mjs",
    "format": "prettier --write src public tests scripts package.json README.md THIRD_PARTY_NOTICES.md",
    "build": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir --win --x64",
    "check": "prettier --check src public tests scripts package.json README.md THIRD_PARTY_NOTICES.md",
    "test:ui": "node scripts/qa-regressions.mjs",
    "test:package": "node scripts/qa-startup.mjs"
  },
  "build": {
    "appId": "io.github.code_lawyer.housediy",
    "productName": "HouseDIY",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "public/**",
      "vendor/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "HouseDIY-${version}-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "prettier": "3.10.1",
    "puppeteer-core": "25.17.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/code-lawyer/HouseDIY.git"
  },
  "homepage": "https://github.com/code-lawyer/HouseDIY#readme",
  "bugs": {
    "url": "https://github.com/code-lawyer/HouseDIY/issues"
  }
}
